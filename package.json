{
  "name": "rgitweb",
  "version": "0.1.0",
  "description": "A fully static, client-side Git repository browser: a cgit replacement that reads dumb-HTTP Git repositories directly from the browser.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist build coverage",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "pako": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.0",
    "@types/jest": "^30.0.0",
    "@types/pako": "^2.0.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-andrewaylett": "^7.0.0",
    "jest": "^30.5.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
